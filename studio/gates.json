{
  "cartridge": "example-sim",
  "gates": [
    { "id": "session", "command": "node scripts/verify-session.mjs", "required": true },
    { "id": "purity", "cartridge": true, "command": "node scripts/check-sim-purity.mjs", "required": true, "lite": true },
    { "id": "isolation", "cartridge": true, "command": "node scripts/check-sim-isolation.mjs", "required": true, "lite": true },
    { "id": "golden", "cartridge": true, "command": "node qa/check-golden.mjs", "required": true, "lite": true },
    { "id": "golden-py", "cartridge": true, "command": "node qa/run-python.mjs qa/test-golden.py", "required": true },
    { "id": "regressions", "cartridge": true, "command": "node qa/check-regressions.mjs", "required": true, "lite": true },
    { "id": "vertical-slice", "cartridge": true, "command": "node qa/vertical-slice.mjs", "required": true },
    { "id": "playtest", "cartridge": true, "command": "node qa/playtest.mjs --stage 1 --quiet", "required": true, "lite": true },
    { "id": "browser-play", "cartridge": true, "command": "node qa/browser-play.mjs --no-shots", "required": true, "cache": false },
    { "id": "soak", "cartridge": true, "command": "node qa/soak.mjs --seeds 3 --ticks 300", "required": true },
    { "id": "tick-budget", "cartridge": true, "command": "node scripts/check-tick-budget.mjs", "required": true },
    { "id": "approvals", "command": "node scripts/check-approvals.mjs", "required": true },
    { "id": "hub-smoke", "command": "node qa/hub-smoke.mjs", "required": true, "deep": true, "cache": false },
    { "id": "assets", "command": "node scripts/check-assets.mjs", "required": true },
    { "id": "docs", "command": "node scripts/check-docs.mjs", "required": true },
    { "id": "fidelity", "command": "node harness/fidelity.mjs", "required": false, "description": "2.30h: a scored report (not a hard gate) of the build against the reference game's mechanics, read from the Game Bible's fidelity section (fallback studio/fidelity.json), a probe per mechanic; the Director reads it and the flow pass sends missing ones back. Mechanics only, never code or art. No checklist: passes." },
    { "id": "game", "command": "node harness/game-gates.mjs", "required": true, "lite": true, "cache": false, "description": "2.30n: the studio game's own checks (its studio.gates.json, or sim/qa.mjs, sim/playtest.mjs, sim/golden.mjs) and, for STUDIO_GATE_PATHS in a Godot project, a headless Godot import + tools/gate.gd. No game set: passes, the cartridge gates cover it." },
    { "id": "godot-unit", "command": "node harness/godot-unit.mjs --changed", "required": true, "lite": true },
    { "id": "controls", "command": "node qa/controls-check.mjs", "required": true, "description": "2.32.0: every control in the Game Bible (studio/bible/controls.json) has a passing real-input result on every track the game ships (web: browser-play; godot: tools/controls.gd via the engine gate). A real game with no controls list fails." },
    { "id": "protected", "command": "node qa/protected-check.mjs", "required": true, "lite": true, "description": "2.32.0: files in studio/protected.json (scenario expectations, regressions, the controls list, gates, the checks themselves) change only with the owner's signed approval (npm run approve). Not enforced until the base branch has an owner key." },
    { "id": "secrets", "command": "node scripts/secret-scan.mjs", "required": true, "lite": true },
    { "id": "content-schema", "command": "node scripts/check-content-schema.mjs", "required": false, "lite": true },
    { "id": "selftest", "command": "node qa/selftest.mjs", "required": true, "deep": true, "cache": false },
    { "id": "balance", "command": "node scripts/balance-sweep.mjs", "required": false },
    { "id": "fun", "command": "node scripts/fun-check.mjs", "required": false },
    { "id": "renderer-budget", "command": "node scripts/check-renderer-budget.mjs", "required": false },
    { "id": "module-size", "command": "node scripts/check-module-size.mjs", "required": false },
    { "id": "function-size", "command": "node scripts/check-function-size.mjs", "required": false },
    { "id": "hud", "command": "node qa/hud-check.mjs", "required": false, "deep": true, "cache": true, "cacheDeep": true },
    { "id": "engine", "command": "node scripts/check-engine.mjs", "required": false },
    { "id": "parity", "command": "node qa/parity.mjs", "required": false },
    { "id": "vision", "command": "node qa/vision-check.mjs", "required": false },
    { "id": "reviewer", "command": "node scripts/check-reviewer.mjs", "required": true }
  ]
}
