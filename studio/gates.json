{
  "cartridge": "example-sim",
  "gates": [
    { "id": "session", "command": "node scripts/verify-session.mjs", "required": true },
    { "id": "purity", "command": "node scripts/check-sim-purity.mjs", "required": true },
    { "id": "isolation", "command": "node scripts/check-sim-isolation.mjs", "required": true },
    { "id": "golden", "command": "node qa/check-golden.mjs", "required": true },
    { "id": "golden-py", "command": "node qa/run-python.mjs qa/test-golden.py", "required": true },
    { "id": "regressions", "command": "node qa/check-regressions.mjs", "required": true },
    { "id": "vertical-slice", "command": "node qa/vertical-slice.mjs", "required": true },
    { "id": "playtest", "command": "node qa/playtest.mjs --stage 1 --quiet", "required": true },
    { "id": "soak", "command": "node qa/soak.mjs --seeds 3 --ticks 300", "required": true },
    { "id": "tick-budget", "command": "node scripts/check-tick-budget.mjs", "required": true },
    { "id": "approvals", "command": "node scripts/check-approvals.mjs", "required": true },
    { "id": "hub-smoke", "command": "node qa/hub-smoke.mjs", "required": true },
    { "id": "docs", "command": "node scripts/check-docs.mjs", "required": true },
    { "id": "secrets", "command": "node scripts/secret-scan.mjs", "required": true },
    { "id": "selftest", "command": "node qa/selftest.mjs", "required": true },
    { "id": "balance", "command": "node scripts/balance-sweep.mjs", "required": false },
    { "id": "fun", "command": "node scripts/fun-check.mjs", "required": false },
    { "id": "renderer-budget", "command": "node scripts/check-renderer-budget.mjs", "required": false },
    { "id": "reviewer", "command": "node scripts/check-reviewer.mjs", "required": false }
  ]
}
