{
  "name": "3d-deep-sim-studio-harness",
  "version": "2.3.0",
  "description": "Agent-agnostic, file-based workflow harness for deep simulation games: pure sim cartridges, seed + tick replay, 64-bit golden hashes, locks, gates, a closed QA loop and a zero-token War Room.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "seed:events": "bash scripts/seed-demo-events.sh",
    "daily:summary": "bash scripts/daily-summary.sh",
    "hub": "node hub/server.mjs",
    "agents": "node harness/agents.mjs",
    "route": "node harness/route.mjs",
    "brief": "node harness/prepare-brief.mjs",
    "replay": "node harness/replay.mjs",
    "closed-loop": "node harness/closed-loop.mjs",
    "task": "node harness/task.mjs",
    "next": "node harness/task.mjs next",
    "event": "node harness/event.mjs",
    "status": "node harness/status.mjs",
    "playtest": "node qa/playtest.mjs",
    "playtest:stage1": "node qa/playtest.mjs --stage 1",
    "playtest:stage2": "node qa/playtest.mjs --stage 2",
    "qa:visual": "node qa/visual-check.mjs",
    "check:purity": "node scripts/check-sim-purity.mjs",
    "check:isolation": "bash scripts/check-sim-isolation.sh",
    "event:sh": "bash scripts/append-event.sh",
    "display:start": "bash scripts/start-agent-display.sh",
    "session:start": "bash scripts/session-start.sh",
    "session:precompact": "bash scripts/pre-compact.sh",
    "setup:token-savers": "bash scripts/setup-token-savers.sh",
    "golden": "node qa/check-golden.mjs",
    "golden:py": "python3 tools/golden.py --check qa/golden",
    "test:golden": "python3 qa/test-golden.py",
    "verify": "node scripts/run-gates.mjs",
    "balance": "node scripts/balance-sweep.mjs --write",
    "fun": "node scripts/fun-check.mjs --write",
    "new-game": "node scripts/new-game.mjs",
    "release": "node scripts/release.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "selftest": "node qa/selftest.mjs",
    "soak": "node qa/soak.mjs --seeds 8 --ticks 600",
    "hub:smoke": "node qa/hub-smoke.mjs",
    "lock": "node harness/lock.mjs",
    "hub:build": "cd hub && npm install --no-audit --no-fund && npx vite build && npx tsc --noEmit --jsx react-jsx --skipLibCheck --esModuleInterop --moduleResolution bundler --module esnext --target es2022 *.tsx"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
