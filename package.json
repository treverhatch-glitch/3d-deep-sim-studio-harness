{
  "name": "3d-deep-sim-studio-harness",
  "version": "2.22.0",
  "description": "Agent-agnostic, file-based workflow harness for deep simulation games: pure sim cartridges, seed + tick replay, 64-bit golden hashes, locks, gates, a closed QA loop and a zero-token War Room.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "seed:events": "bash scripts/seed-demo-events.sh",
    "daily:summary": "bash scripts/daily-summary.sh",
    "hub": "node hub/server.mjs",
    "agents": "node harness/agents.mjs",
    "route": "node harness/route.mjs",
    "brief": "node harness/prepare-brief.mjs",
    "replay": "node harness/replay.mjs",
    "closed-loop": "node harness/closed-loop.mjs",
    "task": "node harness/task.mjs",
    "next": "node harness/task.mjs next",
    "event": "node harness/event.mjs",
    "status": "node harness/status.mjs",
    "handoff": "node harness/handoff.mjs",
    "meeting": "node harness/meeting.mjs",
    "watch": "node harness/watch.mjs",
    "scorecard": "node harness/scorecard.mjs",
    "retro": "node harness/retro.mjs",
    "focus": "node harness/focus.mjs",
    "kickoff": "node harness/kickoff.mjs",
    "notes": "node harness/notes.mjs",
    "models:check": "node harness/models-check.mjs",
    "intake": "node harness/intake.mjs",
    "bible": "node harness/bible.mjs",
    "director": "node harness/director.mjs",
    "idea": "node harness/ideas.mjs",
    "liaison": "node harness/liaison.mjs",
    "experiment": "node harness/experiment.mjs",
    "ref": "node harness/refs.mjs",
    "asset": "node harness/assets.mjs",
    "learn": "node harness/learn.mjs",
    "data": "node harness/data-consent.mjs",
    "preflight": "node scripts/preflight.mjs",
    "run-report": "node harness/run-report.mjs",
    "review": "node harness/review.mjs",
    "agent": "node harness/agent.mjs",
    "mode": "node harness/mode.mjs",
    "ask": "node harness/ask.mjs",
    "art": "node harness/art.mjs",
    "proof": "node harness/proof.mjs",
    "play:browser": "node qa/browser-play.mjs",
    "play": "node harness/builds.mjs",
    "studio:start": "node harness/supervisor.mjs",
    "studio:stop": "node harness/supervisor.mjs stop",
    "studio:status": "node harness/supervisor.mjs status",
    "budget": "node harness/budget.mjs",
    "clip": "node qa/clip.mjs",
    "shot": "node qa/clip.mjs shot",
    "hud:check": "node qa/hud-check.mjs",
    "sign": "node harness/sign.mjs",
    "trajectories": "node harness/trajectories.mjs",
    "onboard": "node scripts/onboard-game.mjs",
    "studio:reset": "node scripts/studio-reset.mjs",
    "playtest": "node qa/playtest.mjs",
    "playtest:stage1": "node qa/playtest.mjs --stage 1",
    "playtest:stage2": "node qa/playtest.mjs --stage 2",
    "qa:visual": "node qa/visual-check.mjs",
    "check:purity": "node scripts/check-sim-purity.mjs",
    "check:isolation": "node scripts/check-sim-isolation.mjs",
    "event:sh": "bash scripts/append-event.sh",
    "display:start": "bash scripts/start-agent-display.sh",
    "session:start": "bash scripts/session-start.sh",
    "session:precompact": "bash scripts/pre-compact.sh",
    "setup:token-savers": "bash scripts/setup-token-savers.sh",
    "golden": "node qa/check-golden.mjs",
    "golden:py": "node qa/run-python.mjs tools/golden.py --check qa/golden",
    "test:golden": "node qa/run-python.mjs qa/test-golden.py",
    "verify": "node scripts/run-gates.mjs",
    "balance": "node scripts/balance-sweep.mjs --write",
    "fun": "node scripts/fun-check.mjs --write",
    "new-game": "node scripts/new-game.mjs",
    "new-studio": "node scripts/new-studio.mjs",
    "causes": "node harness/causes.mjs",
    "release": "node scripts/release.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "selftest": "node qa/selftest.mjs",
    "soak": "node qa/soak.mjs --seeds 8 --ticks 600",
    "hub:smoke": "node qa/hub-smoke.mjs",
    "lock": "node harness/lock.mjs",
    "hub:build": "cd hub && npm install --no-audit --no-fund && npx vite build && npx tsc --noEmit --jsx react-jsx --skipLibCheck --esModuleInterop --moduleResolution bundler --module esnext --target es2022 *.tsx"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
