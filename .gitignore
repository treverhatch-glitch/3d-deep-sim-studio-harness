# deps & builds
node_modules/
hub/node_modules/
dist/
hub/dist/
*.tsbuildinfo

# secrets — never commit keys
.env
.env.*
!.env.example

# runtime state written by the harness (keep README.md, usage.json, and war-room.config.json templates)
.studio/*
!.studio/README.md
!.studio/usage.json
!.studio/war-room.config.json

# QA output (keep the folder, not the runs)
qa/reports/*
!qa/reports/.gitkeep
test-results/
playwright-report/

# generated assets (rebuild with `npm run assets` or tools/blender/generate_glb.py)
public/assets/*.glb
*.blend1

# Python bytecode
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# local tool caches & local reference PDFs
.serena/cache/
.qmd/
3D DEEP-SIM RULES/

# Written by npm run learn from the files it summarises
studio/memory/LEARNED.md

# The reference library's media (npm run ref); the index in studio/references/ is kept
references/
