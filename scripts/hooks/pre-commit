#!/usr/bin/env bash
# Git pre-commit hook. Installed by `npm run hooks:install` (sets core.hooksPath=scripts/hooks).
# Blocks a commit that: stages a key-shaped secret, touches files another agent has locked,
# or (when the sim changed) breaks sim purity or a golden hash.
# Set STUDIO_LOCK_OWNER to your unique agent name. STUDIO_LOCK_STRICT=1 also requires your own lock.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

node scripts/secret-scan.mjs --staged

# Test runs freeze the harness (npm run preflight -- --fix writes .studio/harness-frozen): the game
# changes, the harness that judges it doesn't. Record harness problems as notes instead.
if [ -f .studio/harness-frozen ]; then
  frozen="$(git diff --cached --name-only | grep -E '^(harness|hub|scripts|tools|\.github)/|^qa/[^/]+\.(mjs|py)$|^studio/gates\.json$|^AGENTS(\.lite)?\.md$' || true)"
  if [ -n "$frozen" ]; then
    echo "[pre-commit] FAIL the harness is frozen for this test run. Unstage these and record the problem instead:"
    echo "$frozen" | sed 's/^/  /'
    echo '  npm run notes -- add --kind bad "<what broke and where>"'
    exit 1
  fi
fi
node harness/lock.mjs check-staged ${STUDIO_LOCK_OWNER:+--owner "$STUDIO_LOCK_OWNER"}

# 2.33.0: one door to the studio's branch. When the studio works in lanes (.lanes/<agent> copies), game work
# reaches the main checkout only by landing (task done in a lane). A commit made straight on the main
# checkout may touch studio/ notes and the board, nothing else; builders outside the harness committed
# game code there in the Marina run, unchecked and unrecorded. STUDIO_MAIN_COMMIT=allow lets a person through.
# 2.60.0 (#3): `npm run upgrade -- --merge` sets STUDIO_UPGRADE_MERGE=<the merged commit> in that one commit's
# environment; it lets through only the merge whose MERGE_HEAD is exactly that commit, nothing else.
upgrade_merge=""
if [ -n "${STUDIO_UPGRADE_MERGE:-}" ] && mh="$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null)" && [ "$mh" = "$STUDIO_UPGRADE_MERGE" ]; then
  upgrade_merge=1
fi
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] && [ "${STUDIO_MAIN_COMMIT:-}" != "allow" ] && [ -z "$upgrade_merge" ] \
   && git worktree list --porcelain | grep -q '/\.lanes/'; then
  outside="$(git diff --cached --name-only | grep -vE '^(studio|\.studio)/' || true)"
  if [ -n "$outside" ]; then
    echo "[pre-commit] FAIL this studio works in lanes: game work lands through task done in a lane copy, not a commit on the main checkout:"
    echo "$outside" | head -10 | sed 's/^/  /'
    echo "  (only studio/ notes and the board are committed here; a person can override with STUDIO_MAIN_COMMIT=allow)"
    exit 1
  fi
fi

if git diff --cached --name-only | grep -qE '^(cartridges|src/sim)/'; then
  node scripts/check-sim-purity.mjs >/dev/null || { echo "[pre-commit] FAIL sim purity: run node scripts/check-sim-purity.mjs"; exit 1; }
  node qa/check-golden.mjs >/dev/null || { echo "[pre-commit] FAIL golden hashes changed: if intended, npm run golden -- --update and commit them together"; exit 1; }
fi
# 2.58.2 (PU-29): record the exact tree these checks passed on; commit-msg stamps the commit (Studio-Hooks) only for
# that tree, so the hooks gate can tell a commit made with --no-verify afterwards (harness/hook-stamp.mjs).
git write-tree > "$(git rev-parse --git-path studio-hooks-pass)" 2>/dev/null || true
echo "[pre-commit] PASS"
