#!/usr/bin/env bash
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

node scripts/verify-session.mjs
node scripts/check-sim-purity.mjs

OWNER="${STUDIO_LOCK_OWNER:-}"
if [ -z "$OWNER" ]; then
  echo "[pre-commit] FAIL set STUDIO_LOCK_OWNER to a unique name"
  exit 1
fi

changed=$(git diff --cached --name-only)
if [ -z "$changed" ]; then
  exit 0
fi

for file in $changed; do
  node harness/lock.mjs status "file:$file" >/tmp/lock-status.json
  if ! grep -q '"locked": true' /tmp/lock-status.json; then
    echo "[pre-commit] FAIL $file has no lock. Run: node harness/lock.mjs claim file:$file --owner $OWNER"
    exit 1
  fi
done

echo "[pre-commit] PASS"
