# ============================================================================
# 3D DEEP-SIM AI STUDIO HARNESS — PLUG-AND-PLAY PROVIDER KEYS (.env.example)
#
# SECURITY RULE (docs/SECRETS.md):
#   NEVER commit real API keys, tokens, or credentials to git!
#   Copy this file to `.env` (which is gitignored) and fill in only the
#   providers you use. Preferred cost order:
#     1. Local model (Ollama / Qwen2.5-Coder) -> $0
#     2. Free tiers / credits (NVIDIA NIM, Groq, OpenRouter :free, Vertex $300)
#     3. Paid commercial APIs (Claude, Grok, OpenAI, Cursor)
# ============================================================================

# --- Executive Producer Preset Override (optional) ---
# Allowed: grok | claude | gemini | openai | cursor | ollama | auto
STUDIO_PRODUCER_PRESET=auto

# --- 0. Local Model Fallback (Preferred Tier-0: $0 Offline via Ollama) ---
# Used first for context compression (`harness/prepare-brief.mjs`) & offline coding
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# --- 1. Google Gemini API & Vertex AI / Argon ($300 Cloud Credit / Free Tier) ---
GEMINI_API_KEY=
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# --- 2. NVIDIA NIM Free Developer Tier (GLM-5.3 Flash / Nemotron Ultra / Llama) ---
# Comma-separated or numbered keys supported for automatic key rotation
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=

# --- 3. Groq Cloud Free Tier (Ultra-fast Llama 3.3 70B / Qwen / DeepSeek) ---
GROQ_API_KEY=
GROQ_API_KEY_2=

# --- 4. OpenRouter (Free `:free` channels + unified fallback) ---
OPENROUTER_API_KEY=

# --- 5. xAI Grok (Grok Bot Executive Producer / Thin-Context Orchestrator) ---
XAI_API_KEY=

# --- 6. Anthropic Claude & OpenAI (Optional Paid / Escalation Tiers) ---
# Used after `harness/prepare-brief.mjs` compresses context to <=300 words
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 7. 3D Asset Generation & Blender Orchestrator Bridges ---
# See docs/BLENDER.md and docs/BLENDER-ORCHESTRATOR.md
BLENDER_BIN=blender
BLENDER_ORCHESTRATOR_PORT=3011
# Optional text/image-to-3D mesh generators (never required; headless bpy is default)
MESHY_API_KEY=
REPLICATE_API_TOKEN=
TRIPO3D_API_KEY=
 RODIN_API_KEY=

# --- 8. Optional Grok Bot Local-Agent Webhook (docs/GROKBOT-LOCAL-AGENT.md) ---
PI_NOTIFY_URL=
PI_NOTIFY_SECRET=

# --- 9. Mission Control War Room HUB & Closed-Loop QA Configuration ---
HUB_PORT=3847
HUB_HOST=0.0.0.0
NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
PLAYTEST_URL=http://127.0.0.1:5173/?playtest=1
AGENT_EVENTS_FILE=.studio/events.jsonl
AGENT_EVENTS_MIRROR=/tmp/agent-events.jsonl
STUDIO_USAGE_FILE=.studio/usage.json
WAR_ROOM_CONFIG_FILE=.studio/war-room.config.json
CLOSED_LOOP_MAX_RETRIES=3
