# ============================================================================
# 3D DEEP-SIM AI STUDIO HARNESS — PLUG-AND-PLAY PROVIDER KEYS (.env.example)
#
# SECURITY RULE (docs/SECRETS.md):
#   NEVER commit real API keys, tokens, or credentials to git!
#   Copy this file to `.env` (which is gitignored) and fill in only the
#   providers you use. Preferred cost order:
#     1. Local model (Ollama / Qwen2.5-Coder) -> $0
#     2. Free tiers / credits (NVIDIA NIM, Groq, OpenRouter :free, Vertex $300)
#     3. Paid commercial APIs (Claude, Grok, OpenAI, Cursor)
# ============================================================================

# --- Executive Producer Preset Override (optional) ---
# Allowed: grok | claude | gemini | openai | cursor | ollama | auto
STUDIO_PRODUCER_PRESET=auto

# --- 0. Local Model Fallback (Preferred Tier-0: $0 Offline via Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# --- 1. Google Gemini API & Vertex AI / Argon ---
GEMINI_API_KEY=
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# Optional second key per provider (for example a second paid key or a team key). The router fails
# over across every key you set. Use keys you are entitled to; see docs/BEST-PRACTICES.md.

# --- 2. NVIDIA NIM Free Developer Tier ---
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=

# --- 3. Groq Cloud Free Tier ---
GROQ_API_KEY=
GROQ_API_KEY_2=

# --- 4. OpenRouter ---
OPENROUTER_API_KEY=

# --- 5. xAI Grok ---
XAI_API_KEY=

# --- 6. Anthropic Claude & OpenAI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 7. 3D Asset Generation & Blender Orchestrator Bridges ---
BLENDER_BIN=blender
BLENDER_ORCHESTRATOR_PORT=3011
MESHY_API_KEY=
REPLICATE_API_TOKEN=
TRIPO3D_API_KEY=
RODIN_API_KEY=

# --- 8. Optional Grok Bot Local-Agent Webhook ---
PI_NOTIFY_URL=
PI_NOTIFY_SECRET=

# --- 9. Mission Control War Room HUB & Closed-Loop QA Configuration ---
HUB_PORT=3847
# Bind to localhost by default. Do not expose on 0.0.0.0 unless you know why.
HUB_HOST=127.0.0.1
# Required for any write endpoint (POST /api/tasks, /api/events, /api/macro, etc.) and the WebSocket.
# `npm run setup` replaces this placeholder with a random value in your .env. The HUB ignores
# placeholders and anything shorter than 24 characters, so this line alone never unlocks writes.
HUB_TOKEN=change-me-local-only
# Extra Host names allowed on a loopback bind (e.g. a Tailscale serve name). Comma-separated.
HUB_ALLOWED_HOSTS=
NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
# Only to play a dev server instead of the cartridge's own page or build (it is skipped when it doesn't answer):
# PLAYTEST_URL=http://127.0.0.1:5173/?playtest=1
PLAYTEST_URL=
AGENT_EVENTS_FILE=.studio/events.jsonl
AGENT_EVENTS_MIRROR=/tmp/agent-events.jsonl
STUDIO_USAGE_FILE=.studio/usage.json
WAR_ROOM_CONFIG_FILE=.studio/war-room.config.json
CLOSED_LOOP_MAX_RETRIES=3
MAX_FIX_ATTEMPTS=3

# Studio behaviour (no secrets)
# The model this agent runs on, shown in the War Room and on every event.
STUDIO_AGENT_MODEL=
# Seconds between watcher passes while the HUB runs (0 turns it off).
STUDIO_WATCH_INTERVAL=300
# Daily token cap: input + output + cache reads (weighted, below) since midnight UTC, across launched
# agents and router calls. Empty = the default, 50000000; off turns it off. Past it, no new agent starts
# and router calls are refused; running sessions finish.
STUDIO_DAILY_TOKEN_CAP=
# 2.31.0: a budget per task, across every session on it (empty = default; 0 turns one limit off;
# STUDIO_TASK_BUDGET=off turns them all off). Over budget, the task is parked until someone unparks it.
STUDIO_TASK_MAX_SESSIONS=
STUDIO_TASK_MAX_MIN=
STUDIO_TASK_MAX_TOKENS=
# 2.33.0: launched agents see only their own tool's keys and the studio's settings. Extra names for every
# agent (comma-separated), or for one role with STUDIO_<ROLE>_ENV (e.g. STUDIO_BUILDER_ENV=GH_TOKEN).
# STUDIO_AGENT_ENV=full gives agents everything again (not recommended).
STUDIO_AGENT_ENV_PASS=
# 2.31.0: heavy game checks that may run at once on this machine (default 2: one web, one Godot).
STUDIO_GATE_SLOTS=
# NVIDIA NIM sessions at a time (default 1), and tool:model to fail over to when NIM answers 429.
STUDIO_NIM_MAX_SESSIONS=
STUDIO_NIM_FALLBACK=
# Cache reads count toward the budget meter and the daily cap at this weight (default 0.1).
STUDIO_CACHE_READ_WEIGHT=
# Refresh context by default (npm run session): a launched session hands off at 40 turns or 120000
# tokens of context, whichever comes first; Claude Code gets --max-turns at the ceiling. A mid-debug
# exception is flagged and checked every 20 turns / 40000 tokens past the refresh point. 0 turns one off.
STUDIO_SESSION_TURNS=
STUDIO_SESSION_CONTEXT=
STUDIO_SESSION_CEILING_TURNS=
STUDIO_CHECK_TURNS=
STUDIO_CHECK_TOKENS=
# The Producer agent's name (e.g. grok-producer), so script events and the Producer show as one person.
STUDIO_PRODUCER_NAME=
# Agents the harness can start itself (npm run agent, the War Room's Start agent, auto-start in fast
# paces): the tool (claude | codex | agy | cursor | grok | aider) and model for every role, and
# per-role overrides. STUDIO_<ROLE>_CMD replaces the whole command ({kickoff} {agent} {model} {role}).
# Suggested models per role (a strong suggestion, not enforced; npm run models:check shows the tiers):
# builders and the Producer on a mid tier (e.g. claude-sonnet-*), the Director, planner and hard ports
# on the top tier (e.g. claude-opus-*), check-ins and summaries on a cheap tier (e.g. claude-haiku-*,
# *-flash, glm-*), and the reviewer from another model family. The top tier on every role shows a
# warning in the War Room that the game dev accepts with one click.
STUDIO_AGENT_TOOL=
STUDIO_AGENT_MODEL=
STUDIO_PRODUCER_TOOL=
STUDIO_PRODUCER_MODEL=
STUDIO_BUILDER_TOOL=
STUDIO_BUILDER_MODEL=
STUDIO_DIRECTOR_TOOL=
STUDIO_DIRECTOR_MODEL=
# Codex in a frozen test clone: 1 runs it without its sandbox (macOS's blocks git commits and 127.0.0.1)
STUDIO_CODEX_BYPASS=
# Backups of everything the studio learned (a Google Drive / Dropbox / OneDrive folder on this
# computer, shared with no one but your team). docs/BACKUPS.md
STUDIO_BACKUP_DIR=
STUDIO_BACKUP_KEEP=60
STUDIO_BACKUP_MEDIA=20
# Test-run results: the HUB writes REPORT.md here hourly (npm run run-report). docs/TEST-RUN.md
STUDIO_RESULTS_DIR=
# Where the reference library keeps downloaded media (large files; its own synced folder if you like)
STUDIO_REFERENCE_DIR=
# Rotate .studio/events.jsonl past this size in MB.
STUDIO_EVENTS_MAX_MB=25
# The global name a browser game exposes its playtest API on (default __sim).
PLAYTEST_GLOBAL=__sim

# 2.30: the opt-in watchdog (npm run watchdog -- on --by <you>; off by default). When on:
# hand off a session whose refresh check went unanswered this many minutes,
# STUDIO_WATCHDOG_CHECK_MIN=15
# park a task handed back this many times in 2 hours,
# STUDIO_WATCHDOG_HANDBACKS=3
# stop the studio when no task finished in this many hours while sessions ran.
# STUDIO_WATCHDOG_IDLE_HOURS=2
# 2.30j: run the browser check after the launcher closes a task (on by default).
# STUDIO_POST_BROWSER_PLAY=off
