# ============================================================================
# 3D DEEP-SIM AI STUDIO HARNESS — PLUG-AND-PLAY PROVIDER KEYS (.env.example)
# Copy to `.env` and fill in any providers you have. You do NOT need all of them!
# `harness/route.mjs` (freecc:auto) automatically skips missing keys, rotates
# free channels, and fails over on 429/5xx with a 30s+ cooldown.
# ============================================================================

# --- Executive Producer Preset Override (optional) ---
# Set to: grok | claude | gemini | openai | cursor | ollama | auto
STUDIO_PRODUCER_PRESET=auto

# --- 1. Google Gemini API & Vertex AI ($300 Cloud Credit / Free Tier) ---
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# --- 2. NVIDIA NIM Free Developer Tier (GLM-5 / Nemotron Ultra / Llama) ---
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=

# --- 3. Groq Free Tier (Ultra-fast Llama / Qwen / DeepSeek) ---
GROQ_API_KEY=
GROQ_API_KEY_2=

# --- 4. OpenRouter (Free :free channels + unified fallback) ---
OPENROUTER_API_KEY=

# --- 5. xAI Grok (Grok Bot Executive Producer option) ---
XAI_API_KEY=

# --- 6. Anthropic Claude & OpenAI (Optional commercial tiers) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 7. Local Ollama (Zero-cost offline fallback) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# --- 8. Workflow UI HUB & QA Configuration ---
HUB_PORT=4177
AGENT_EVENTS_FILE=.studio/events.jsonl
AGENT_EVENTS_MIRROR=/tmp/agent-events.jsonl
PLAYTEST_URL=http://127.0.0.1:5173/?playtest=1
