{
  "mcpServers": {
    "qmd": {
      "command": "qmd",
      "args": ["mcp"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@main",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "."
      ],
      "note": "Pin to a commit SHA when you depend on this in production."
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.32",
        "--headless",
        "--caps=vision"
      ]
    },
    "blender-orchestrator": {
      "command": "npx",
      "args": [
        "-y",
        "github:mlolson/blender-orchestrator#main"
      ],
      "note": "Pin to a commit SHA for reproducible setups."
    }
  }
}
