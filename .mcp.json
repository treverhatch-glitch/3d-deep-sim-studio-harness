{
  "mcpServers": {
    "qmd": {
      "command": "qmd",
      "args": ["mcp"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "."
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--caps=vision"
      ]
    },
    "blender-orchestrator": {
      "command": "npx",
      "args": [
        "-y",
        "github:mlolson/blender-orchestrator#a9dfb32d41709dd013b3c6ca0802bb869040656d"
      ],
      "note": "Repo has no release tags; pinned to the main commit of 2026-10-20. Bump the SHA deliberately."
    }
  }
}
